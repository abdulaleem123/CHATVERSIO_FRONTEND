# Copy to .env for the optional Node reference backend. Never serve this file.
PORT=3000
HOST=127.0.0.1
# Absolute path recommended in production; use a persistent volume.
DATA_DIRECTORY=./data
# Set to the exact HTTPS origin of your website when behind a reverse proxy.
ALLOWED_ORIGIN=http://127.0.0.1:3000
# Optional: npm run deliver forwards saved requests to your own receiver.
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=

# ---- Vercel API routes (api/contact.ts, api/schedule.ts) ----
# Same names as the original Next.js site. Set these in Vercel > Settings > Environment Variables.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional; comma-separated list allowed. esha@chatversio-ai.com is always added.
NOTIFY_EMAIL=
NEXT_PUBLIC_SITE_URL=https://chatversio-ai.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
